# Copy this file to .env and fill in your own key:  cp .env.example .env

OPENAI_API_KEY=your-openai-api-key-here

# Optional: AI model for all agents (default: gpt-4.1)
# OPENAI_MODEL=gpt-4.1

# Optional: hide the browser windows (default: false, so you can watch the agents)
# HEADLESS=true

# Jira: the stories are read through the Atlassian MCP server with your API token
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token-here
ATLASSIAN_CLOUD_ID=your-site.atlassian.net

# Optional: the app under test (default: https://freelance-learn-automation.vercel.app/login)
# APP_URL=https://freelance-learn-automation.vercel.app/login
